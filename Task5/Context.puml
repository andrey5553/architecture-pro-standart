@startuml C4_Context_Diagram
set separator none
title Bank - Credit Context (MVP)

top to bottom direction

!include <C4/C4_Container>

Person(NewClient, "Новый клиент", "Подает заявку на кредит через сайт")
Person(CallCenterAgent, "Менеджер кол-центра", "Обрабатывает заявки")
Person(BackOffice, "Бэк-офис", "Принимает заявки, передает их в кредитный отдел и сообщает о результате")

System(website, "Сайт банка", "")
System(ABS, "АБС", "")
